// 2. PARE-FEU ANTI-DDOS & RATE LIMITING
const requestTracker = new Map();
function rateLimiter(req, res, next) {
  const ip = req.ip || req.headers['x-forwarded-for'] || 'unknown';
  const now = Date.now();
  const windowTime = 60 * 1000;
  const maxRequests = 60;

  if (!requestTracker.has(ip)) {
    requestTracker.set(ip, { count: 1, startTime: now });
  } else {
    const data = requestTracker.get(ip);
    if (now - data.startTime < windowTime) {
      data.count++;
      if (data.count > maxRequests) {
        return res.status(429).json({
          company: "WEMAD",
          error: "Trop de requêtes. Accès temporairement bloqué par le pare-feu WEMAD Z^Z.",
          code: "TOO_MANY_REQUESTS"
        });
      }
    } else {
      requestTracker.set(ip, { count: 1, startTime: now });
    }
  }
  next();
}

app.use(rateLimiter);

// 3. MIDDLEWARE DE SÉCURITÉ ZERO-TRUST (Vérification des 200$/mois ou Bypass Admin)
function verifyWemadZZSecurity(req, res, next) {
  const rawApiKey = req.headers['x-zz-secure-key'] || req.headers['x-wemad-api-key'];

  if (!rawApiKey) {
    return res.status(401).json({
      company: "WEMAD",
      infrastructure: "ZALAPUISSANCE_Z",
      error: "Accès refusé. Clé d'API WEMAD Z^Z manquante.",
      code: "UNAUTHORIZED_ACCESS"
    });
  }

  const incomingKeyHash = crypto.createHash('sha256').update(rawApiKey).digest('hex');
  const subscriber = wemadeSecureDatabase.get(incomingKeyHash);

  // Si la clé n'existe pas ou n'est pas active -> Code 402 Payment Required
  if (!subscriber || subscriber.status !== 'ACTIVE') {
    return res.status(402).json({
      company: "WEMAD",
      infrastructure: "ZALAPUISSANCE_Z",
      error: "Paiement requis. Abonnement exclusif requis à 200 $/mois pour accéder au supercalculateur WEMAD Z^Z.",
      code: "PAYMENT_REQUIRED",
      price_usd: 200.00,
      checkout_url: "https://z.wemad.com/billing"
    });
  }

  if (subscriber.computeCreditsUSD <= 0) {
    return res.status(402).json({
      company: "WEMAD",
      infrastructure: "ZALAPUISSANCE_Z",
      error: "Crédits de calcul épuisés. Veuillez renouveler votre abonnement à 200 $.",
      code: "INSUFFICIENT_CREDITS"
    });
  }

  req.subscriber = subscriber;
  next();
}

// 4. CONFIGURATION DU STOCKAGE VIDÉO ILLIMITÉ (0% de saturation RAM VPS)
const s3Config = new S3Client({
  endpoint: process.env.SPACES_ENDPOINT || "https://fra1.digitaloceanspaces.com",
  region: "us-east-1",
  credentials: {
    accessKeyId: process.env.SPACES_KEY || "VOTRE_SPACES_KEY",
