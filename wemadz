});

// Endpoint : Génération d'une URL d'upload direct pour stocker n'importe quelle vidéo dans le Cloud
app.post('/api/v1/video/generate-upload-url', verifyWemadZZSecurity, async (req, res) => {
  try {
    const { fileName, fileType } = req.body;
    const fileKey = `wemad_vault/videos/${Date.now()}_${fileName}`;

    const command = new PutObjectCommand({
      Bucket: process.env.SPACES_BUCKET || 'wemad-zz-global-storage',
      Key: fileKey,
      ContentType: fileType,
      ACL: 'private'
    });

    const uploadUrl = await getSignedUrl(s3Config, command, { expiresIn: 900 });

    res.status(200).json({
      status: "SUCCESS",
      company: "WEMAD",
      core: "ZALAPUISSANCE_Z",
      message: "Lien de stockage vidéo illimité généré avec succès.",
      upload_url: uploadUrl,
      file_key: fileKey
    });
  } catch (error) {
    res.status(500).json({ error: "Erreur d'allocation du stockage cloud." });
  }
});

